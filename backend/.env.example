PORT=3001
FRONTEND_ORIGIN=http://localhost:5173

# Optional — enables real AI answers for Ask AAS (server-side only; the
# key is never exposed to the frontend). Any OpenAI-compatible chat API works.
# Leave empty to use the built-in safe demo guidance engine.
AI_API_KEY=
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_MODEL=gpt-4o-mini
